# Configuration for NPM Ignore, excluding specific paths when publishing to NPM.
# For more details, refer to: https://docs.npmjs.com/cli/v9/using-npm/developers#keeping-files-out-of-your-package

# Source and Development Files
# These files are used during development but not needed in the published package.
src/
tests/
examples/
scripts/
docs/

# Build Outputs and Temporary Files
# Files generated during the build process or temporary files.
coverage/
dist/
build/
.jest/
.turbo/
tmp/
temp/
*.min.js

# Configuration Files
# Various configuration files that are not relevant for the published package.
tsconfig.json
jest.config.ts
.eslintrc.jsonc
.prettierrc.jsonc
.editorconfig
.gitattributes
.gitignore
.prettierignore
.eslintignore
.npmrc # npm config file

# Lock Files
# Package manager lock files are generally not included in published packages.
pnpm-lock.yaml
yarn.lock
package-lock.json.old

# IDE and Editor Specific Files
# Files generated by IDEs or text editors.
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# Version Control and Miscellaneous Files
# Files related to version control or other miscellaneous items.
.git/
.env* # Environment variables

# Logs
# Log files generated during development.
logs/
*.log
npm-debug.log*
yarn-error.log*
lerna-debug.log*

# Documentation and Project Information
# Some documentation files might not be needed in the published package.
README.dev.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
CHANGELOG.md

# Test and coverage specific files
# These are used for testing and coverage reports, not for the production package.
**/*.test.ts
**/*.spec.ts
